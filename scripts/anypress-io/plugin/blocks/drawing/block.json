{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "anypress-io/drawing",
	"version": "0.1.0",
	"title": "anypress.io Drawing",
	"category": "media",
	"description": "One of anypress.io's hand-drawn pictures, drawn in as the page scrolls to it. Pick the drawing in the block's settings.",
	"keywords": [
		"drawing",
		"illustration",
		"sketch"
	],
	"textdomain": "anypress-io",
	"attributes": {
		"name": {
			"type": "string",
			"source": "attribute",
			"selector": "div",
			"attribute": "data-drawing",
			"default": "question"
		},
		"ratio": {
			"type": "string"
		}
	},
	"supports": {
		"className": false,
		"html": false
	},
	"editorScript": "file:./index.js"
}
